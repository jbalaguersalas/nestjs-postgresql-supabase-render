{
  "info": {
    "name": "API libros - Apunte 07",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Peticiones del apunte 07. La variable baseUrl es http://localhost:3000/api. Antes del apartado 2 (versiones) usa las rutas sin /v1."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    }
  ],
  "item": [
    {
      "name": "1. Stock (antes de versiones)",
      "item": [
        {
          "name": "Listar libros",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/books",
            "description": ""
          }
        },
        {
          "name": "Ej 1 - PATCH stock libro 2",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/books/2",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stock\": 20\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Esperado: 200 con stock 20"
          }
        },
        {
          "name": "Crear libro con stock",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/books",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Libro de prueba\",\n  \"author\": \"Yo\",\n  \"pages\": 100,\n  \"stock\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": ""
          }
        }
      ]
