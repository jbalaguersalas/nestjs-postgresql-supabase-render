{
  "info": {
    "name": "Apunte 07 - API de libros",
    "description": "Peticiones de los ejercicios del apunte 07. Antes de usarla: docker compose up -d y npm run start:dev. Cada petición comprueba el código de estado esperado (pestaña Test Results).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" }
  ],
  "item": [
    {
      "name": "0. Libros v1 (CRUD)",
      "item": [
        {
          "name": "Listar libros",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 y devuelve un array', () => {", "  pm.response.to.have.status(200);", "  pm.expect(pm.response.json()).to.be.an('array');", "});"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/v1/books" }
        },
        {
          "name": "Listar libros de un autor",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200', () => pm.response.to.have.status(200));"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/v1/books?author=garcia" }
        },
        {
          "name": "Un libro",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200', () => pm.response.to.have.status(200));"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/v1/books/1" }
        },
        {
          "name": "Crear libro (con stock)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('201', () => pm.response.to.have.status(201));"] } }],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/books",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Libro de prueba\",\n  \"author\": \"Yo mismo\",\n  \"pages\": 100,\n  \"stock\": 3\n}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "Ej. 1 - Cambiar stock del libro 2",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 y stock = 20', () => {", "  pm.response.to.have.status(200);", "  pm.expect(pm.response.json().stock).to.eql(20);", "});"] } }],
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/v1/books/2",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"stock\": 20\n}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "Borrar libro (cambia el id antes)",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/v1/books/13" }
        }
      ]
    },
    {
      "name": "Ej. 2 - Versiones",
      "item": [
        {
          "name": "v1 existe → 200",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200', () => pm.response.to.have.status(200));"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/v1/books/1" }
        },
        {
          "name": "v3 no existe → 404",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('404', () => pm.response.to.have.status(404));"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/v3/books" }
        },
        {
          "name": "Sin versión → 404",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('404', () => pm.response.to.have.status(404));"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/books/1" }
        }
      ]
    },
    {
      "name": "Ej. 4 - Paginación (v2)",
      "item": [
        {
          "name": "1. Por defecto → 10 libros, totalPages 2",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200, 10 libros y 2 páginas', () => {", "  pm.response.to.have.status(200);", "  const body = pm.response.json();", "  pm.expect(body.data.length).to.eql(10);", "  pm.expect(body.totalPages).to.eql(2);", "});"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/v2/books" }
        },
        {
          "name": "2. Página 2 de 5 → libros 6 al 10",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 y empieza en el libro 6', () => {", "  pm.response.to.have.status(200);", "  pm.expect(pm.response.json().data[0].id).to.eql(6);", "});"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/v2/books?page=2&limit=5" }
        },
        {
          "name": "3. Los 3 más largos",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 y 3 libros', () => {", "  pm.response.to.have.status(200);", "  pm.expect(pm.response.json().data.length).to.eql(3);", "});"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/v2/books?sort=pages&order=desc&limit=3" }
        },
        {
          "name": "4. Filtrar por autor → total 3",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 y total 3', () => {", "  pm.response.to.have.status(200);", "  pm.expect(pm.response.json().total).to.eql(3);", "});"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/v2/books?author=márquez" }
        }
      ]
    },
    {
      "name": "Ej. 5 - Rómpelo (todos 400)",
      "item": [
        {
          "name": "limit=100",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('400', () => pm.response.to.have.status(400));"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/v2/books?limit=100" }
        },
        {
          "name": "page=0",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('400', () => pm.response.to.have.status(400));"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/v2/books?page=0" }
        },
        {
          "name": "sort=price",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('400', () => pm.response.to.have.status(400));"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/v2/books?sort=price" }
        },
        {
          "name": "order=up",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('400', () => pm.response.to.have.status(400));"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/v2/books?order=up" }
        }
      ]
    },
    {
      "name": "Ej. 6 - Página que no existe",
      "item": [
        {
          "name": "page=99 → 200 con data vacía",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 y data vacía', () => {", "  pm.response.to.have.status(200);", "  pm.expect(pm.response.json().data).to.eql([]);", "});"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/v2/books?page=99" }
        }
      ]
    }
  ]
}
